{
  "name": "meathill-brand",
  "version": "0.1.0",
  "description": "Meathill Studio 跨站品牌清单、设计 token 与导航工具",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["*.css", "styles/*.css"],
  "files": ["dist", "styles", "assets"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
